<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>PCSteward.NativePrototype</RootNamespace>
    <AssemblyName>PCSteward.NativePrototype</AssemblyName>
    <ApplicationIcon>..\assets\ico\pc-steward.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1822;CA1859</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\assets\ico\pc-steward.ico" Link="Assets\pc-steward.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\png\logo-mark-64.png" Link="Assets\logo-mark-64.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\svg\empty-first-scan.svg" Link="Assets\empty-first-scan.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\svg\empty-no-findings.svg" Link="Assets\empty-no-findings.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\svg\empty-offline.svg" Link="Assets\empty-offline.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
