<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <!--
      Security review H1: this program runs elevated, and its environment comes from the user's own registry. The host must
      not take the .NET location from DOTNET_ROOT (only the machine-registered and default locations, which need an
      administrator to change), and the runtime must ignore DOTNET_STARTUP_HOOKS. AppHostDotNetSearch applies to the
      published apphost, which is what the deployment ships.
    -->
    <StartupHookSupport>false</StartupHookSupport>
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <!--
      ADR-033 (security review H1, closed): the published helper is one Native AOT image. It has no JIT, profiler API, startup
      hooks or runtime to locate, so no environment value the owner's session can write loads code into it or makes its
      runtime write files. EventSource (EventPipe and the diagnostic server) stays compiled out. The two switches above stay
      as a second layer and keep a non-AOT build of this project safe.
    -->
    <PublishAot>true</PublishAot>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PCSteward.Application/PCSteward.Application.csproj" />
    <ProjectReference Include="../PCSteward.Execution/PCSteward.Execution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-022 alignment note: the pinned protocol-2 capability statement, published at the payload root with exact bytes. -->
    <None Include="PCSteward.DeploymentCapability.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
