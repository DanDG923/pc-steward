<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <MicrosoftManagementDeployment-Platform>x64</MicrosoftManagementDeployment-Platform>
    <MicrosoftManagementDeployment-FactoryLinkage>none</MicrosoftManagementDeployment-FactoryLinkage>
    <!--
      Task 54B (ADR-003 amendment 1): from 1.28 on, ComInterop's lib/uap10.0 winmd and the InProcCom runtime winmd have the
      same API surface but different bytes. Ship the winmd that belongs to the shipped in-process runtime, from InProcCom,
      beside the other three runtime leaves, and stop ComInterop copying its own; the packaging evidence owns all four leaves.
    -->
    <MicrosoftManagementDeployment-OutputWinMD>false</MicrosoftManagementDeployment-OutputWinMD>
    <ApplicationIcon>..\..\design\assets\ico\pc-steward.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.WindowsPackageManager.InProcCom" GeneratePathProperty="true" IncludeAssets="none">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <ProjectReference Include="../PCSteward.Application/PCSteward.Application.csproj" />
    <ProjectReference Include="../PCSteward.Persistence.Sqlite/PCSteward.Persistence.Sqlite.csproj" />
    <ProjectReference Include="../PCSteward.Inventory.Windows/PCSteward.Inventory.Windows.csproj" />
    <ProjectReference Include="../PCSteward.Provider.WinGet/PCSteward.Provider.WinGet.csproj" />
    <ProjectReference Include="../PCSteward.Provider.Chocolatey/PCSteward.Provider.Chocolatey.csproj" />
    <ProjectReference Include="../PCSteward.Execution/PCSteward.Execution.csproj" />
    <ProjectReference Include="../PCSteward.SelfUpdate/PCSteward.SelfUpdate.csproj" />
    <ProjectReference Include="../PCSteward.Storage/PCSteward.Storage.csproj" />
    <ProjectReference Include="../PCSteward.Scheduling.Windows/PCSteward.Scheduling.Windows.csproj" />
    <ProjectReference Include="../PCSteward.ScheduledHost/PCSteward.ScheduledHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PCSteward.Diagnostics/PCSteward.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\design\assets\ico\pc-steward.ico" Link="Assets\pc-steward.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\design\assets\png\logo-mark-64.png" Link="Assets\logo-mark-64.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)\runtimes\win-x64\native\Microsoft.Management.Deployment.InProc.dll" Link="Microsoft.Management.Deployment.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)\runtimes\win-x64\native\Microsoft.Management.Deployment.InProc.dll.manifest" Link="Microsoft.Management.Deployment.dll.manifest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)\runtimes\win-x64\native\WindowsPackageManager.dll" Link="WindowsPackageManager.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)\runtimes\win-x64\native\Microsoft.Management.Deployment.winmd" Link="Microsoft.Management.Deployment.winmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyScheduledHostRuntimeAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <ScheduledHostBuildRuntime Include="$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PCSteward.ScheduledHost.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <ScheduledHostBuildRuntime Include="$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\PCSteward.ScheduledHost.*" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PCSteward.ScheduledHost.dll') And '$(RuntimeIdentifier)' != ''" Text="Required RID-specific PCSteward.ScheduledHost.dll is missing." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\PCSteward.ScheduledHost.dll') And '$(RuntimeIdentifier)' == ''" Text="Required PCSteward.ScheduledHost.dll is missing." />
    <Copy SourceFiles="@(ScheduledHostBuildRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyScheduledHostRuntimeAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <ScheduledHostPublishRuntime Include="$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PCSteward.ScheduledHost.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <ScheduledHostPublishRuntime Include="$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\PCSteward.ScheduledHost.*" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PCSteward.ScheduledHost.dll') And '$(RuntimeIdentifier)' != ''" Text="Required RID-specific PCSteward.ScheduledHost.dll is missing from publish inputs." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\PCSteward.ScheduledHost\bin\$(Configuration)\$(TargetFramework)\PCSteward.ScheduledHost.dll') And '$(RuntimeIdentifier)' == ''" Text="Required PCSteward.ScheduledHost.dll is missing from publish inputs." />
    <Copy SourceFiles="@(ScheduledHostPublishRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
