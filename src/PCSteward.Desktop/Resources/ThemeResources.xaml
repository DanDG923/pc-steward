<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spacing on the 4 px grid (mirrored by StewardSpacing in StewardPresentation.cs). -->
    <x:Double x:Key="StewardSpacingXSmall">4</x:Double>
    <x:Double x:Key="StewardSpacingSmall">8</x:Double>
    <x:Double x:Key="StewardSpacingMedium">12</x:Double>
    <x:Double x:Key="StewardSpacingLarge">16</x:Double>
    <x:Double x:Key="StewardSpacingSection">20</x:Double>
    <x:Double x:Key="StewardSpacingXLarge">24</x:Double>
    <x:Double x:Key="StewardSpacingXXLarge">32</x:Double>
    <x:Double x:Key="StewardTitleBarHeight">32</x:Double>
    <!-- UI polish Phase 1 (approved targets): the page column sits beside the navigation, left aligned, like Windows Settings
         (mirrored by StewardSpacing.PagePadding). Phase 5: the column has no maximum width, so a maximised window is filled. -->
    <Thickness x:Key="StewardPagePadding">28,12,40,40</Thickness>
    <Thickness x:Key="StewardCardPadding">20</Thickness>
    <Thickness x:Key="StewardRowCardPadding">16,12</Thickness>
    <!-- Windows 11 geometry: 4 px control corners, 8 px card and overlay corners, 6 px icon wells. -->
    <CornerRadius x:Key="StewardControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="StewardCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="StewardIconWellCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="StewardChipCornerRadius">11</CornerRadius>
</ResourceDictionary>
