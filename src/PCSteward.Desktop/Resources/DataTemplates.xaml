<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="StewardApplicationRowTemplate">
        <Grid
            MinHeight="64"
            Padding="12,8"
            ColumnSpacing="12"
            AutomationProperties.Name="{Binding AccessibleSummary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="0.85*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Background="{ThemeResource StewardBrandSubtleBrush}"
                CornerRadius="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource StewardBrandTextBrush}"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource StewardTextBrush}"
                    MaxLines="1"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource StewardCaptionStyle}"
                    MaxLines="1"
                    Text="{Binding Publisher}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    Foreground="{ThemeResource StewardTextBrush}"
                    MaxLines="1"
                    Text="{Binding Version}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource StewardCaptionStyle}"
                    MaxLines="1"
                    Text="{Binding ScopeAndProvider}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- The same status chip as StewardVisuals.Badge: glyph, label and tone brushes from StatusVocabulary. -->
            <Border
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding StatusBackground}"
                BorderBrush="{Binding StatusForeground}"
                Style="{StaticResource StewardStatusChipStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="12"
                        Foreground="{Binding StatusForeground}"
                        Glyph="{Binding StatusGlyph}" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding StatusForeground}"
                        Text="{Binding StatusLabel}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
