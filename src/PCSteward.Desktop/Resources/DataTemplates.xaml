<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI polish phase 4 (approved target T-Installed): one row per record, in the columns Name, Version, Installed for and Update
         source, with a chevron because the row opens the app's details. Neutral statuses ("No update source", "Pinned", ...) are
         plain secondary text; statuses that ask for a look use the tinted chip. -->
    <DataTemplate x:Key="StewardApplicationRowTemplate">
        <Grid
            MinHeight="56"
            Padding="12,8"
            ColumnSpacing="16"
            AutomationProperties.Name="{Binding AccessibleSummary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <!-- ADR-035: the two-letter tile, and over it the app's own icon when one could be read (MainWindow.AppIcons.cs
                 shows the image and hides the letters). The image is decoration: the row's name is the app's name. -->
            <Grid Width="32" Height="32" VerticalAlignment="Center">
                <Border Background="{ThemeResource StewardIconWellBrush}" CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StewardTextBrush}"
                        Text="{Binding Initials}" />
                </Border>
                <Image
                    Width="32"
                    Height="32"
                    AutomationProperties.AccessibilityView="Raw"
                    AutomationProperties.AutomationId="AppIcon"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Foreground="{ThemeResource StewardTextBrush}"
                    MaxLines="1"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource StewardCaptionStyle}"
                    Foreground="{ThemeResource StewardSecondaryTextBrush}"
                    MaxLines="1"
                    Text="{Binding PublisherAndProvider}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource StewardTextBrush}"
                MaxLines="1"
                Text="{Binding VersionText}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                Foreground="{ThemeResource StewardSecondaryTextBrush}"
                MaxLines="1"
                Text="{Binding ScopeLabel}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                Foreground="{ThemeResource StewardSecondaryTextBrush}"
                MaxLines="1"
                Text="{Binding StatusLabel}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding PlainStatusVisibility}" />
            <!-- The same status chip as StewardVisuals.Badge: glyph, label and tone brushes from StatusVocabulary. -->
            <Border
                Grid.Column="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{Binding StatusBackground}"
                Style="{StaticResource StewardStatusChipStyle}"
                Visibility="{Binding ChipVisibility}">
                <!-- A grid, not a horizontal StackPanel: the label gets the column's width, so a long label wraps instead of being cut off. -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{Binding StatusForeground}"
                        Glyph="{Binding StatusGlyph}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding StatusForeground}"
                        Text="{Binding StatusLabel}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
            <FontIcon
                Grid.Column="5"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource StewardSecondaryTextBrush}"
                Glyph="&#xE76C;" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
