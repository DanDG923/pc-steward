<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI polish Phase 1: controls keep the Windows App SDK defaults (32 epx buttons and inputs, 4 px corners, Fluent focus
         rectangles); these styles add only what PC Steward needs on top. -->
    <Style x:Key="StewardCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StewardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StewardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StewardCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource StewardCardPadding}" />
    </Style>
    <!-- A Settings-style row card (StewardVisuals.RowCard): icon well, title, description and its control or a chevron. -->
    <Style x:Key="StewardRowCardStyle" TargetType="Border" BasedOn="{StaticResource StewardCardStyle}">
        <Setter Property="Padding" Value="{StaticResource StewardRowCardPadding}" />
        <Setter Property="MinHeight" Value="68" />
    </Style>
    <!-- The same row card as one button (StewardVisuals.NavigationRow), so the whole row is a single focusable, named target. -->
    <Style x:Key="StewardRowCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource StewardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StewardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StewardCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource StewardRowCardPadding}" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <Style x:Key="StewardIconWellStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{ThemeResource StewardIconWellBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource StewardIconWellCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StewardButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <Style x:Key="StewardPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <Style x:Key="StewardInputStyle" TargetType="TextBox">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <Style x:Key="StewardSelectStyle" TargetType="ComboBox">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <!-- A status chip: a tinted pill whose label and glyph carry the meaning (colour is never the only signal). The border is
         transparent in Light and Dark and the window-text colour in high contrast, so the chip keeps a visible edge there. -->
    <Style x:Key="StewardStatusChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StewardSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StewardChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StewardChipCornerRadius}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="StewardListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource StewardFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource StewardFocusInnerBrush}" />
    </Style>
    <Style x:Key="StewardListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsItemClickEnabled" Value="True" />
    </Style>
</ResourceDictionary>
