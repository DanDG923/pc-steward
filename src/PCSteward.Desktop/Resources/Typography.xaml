<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 (Fluent) type ramp, Segoe UI Variable: Caption 12/16, Body 14/20, Body Strong 14/20 semibold, Body Large 18/24,
         Subtitle 20/28, Title 28/36, Title Large 40/52. Pages use the semantic styles below; sizes come only from these tokens.
         UI polish Phase 1 (approved targets): page descriptions are Body in the secondary text colour, directly under the title;
         section headings are Body Strong, as in Windows Settings; captions are for metadata only. -->
    <x:Double x:Key="StewardCaptionFontSize">12</x:Double>
    <x:Double x:Key="StewardBodyFontSize">14</x:Double>
    <x:Double x:Key="StewardBodyLargeFontSize">18</x:Double>
    <x:Double x:Key="StewardSubtitleFontSize">20</x:Double>
    <x:Double x:Key="StewardTitleFontSize">28</x:Double>
    <x:Double x:Key="StewardTitleLargeFontSize">40</x:Double>

    <Style x:Key="StewardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource StewardTitleFontSize}" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StewardTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StewardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource StewardSubtitleFontSize}" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StewardTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StewardPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource StewardTitleStyle}" />
    <Style x:Key="StewardDisplayStyle" TargetType="TextBlock" BasedOn="{StaticResource StewardTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource StewardTitleLargeFontSize}" />
        <Setter Property="LineHeight" Value="52" />
    </Style>
    <Style x:Key="StewardBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource StewardBodyFontSize}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource StewardSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StewardBodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource StewardBodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StewardTextBrush}" />
    </Style>
    <!-- Section headings: Body Strong (14/20 semibold, primary text), as Windows Settings groups its cards. -->
    <Style x:Key="StewardSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource StewardBodyStrongStyle}" />
    <!-- Row titles inside row cards: Body in the primary text colour. -->
    <Style x:Key="StewardRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource StewardBodyStyle}">
        <Setter Property="Foreground" Value="{ThemeResource StewardTextBrush}" />
    </Style>
    <Style x:Key="StewardBodyLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource StewardBodyLargeFontSize}" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource StewardSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The optional line above a page title (for example "Read only"): Caption in the secondary text colour, sentence case. -->
    <Style x:Key="StewardEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource StewardCaptionFontSize}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource StewardSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StewardCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource StewardCaptionFontSize}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource StewardTertiaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
