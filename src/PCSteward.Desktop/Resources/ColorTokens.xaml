            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="StewardTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="StewardTextBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="StewardTextBrush" />
