            <SolidColorBrush x:Key="StewardInfoBrush" Color="#99EBFF" />
            <SolidColorBrush x:Key="StewardInfoSurfaceBrush" Color="#1F3A47" />
            <!-- Colour option 2 (owner choice 2026-11-11): Settings-style hues for decorative icon wells; each glyph is at least 4.5:1 on its surface. -->
            <SolidColorBrush x:Key="StewardHueBlueBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="StewardHueBlueSurfaceBrush" Color="#1F3347" />
            <SolidColorBrush x:Key="StewardHueTealBrush" Color="#4FD8B4" />
            <SolidColorBrush x:Key="StewardHueTealSurfaceBrush" Color="#173B33" />
            <SolidColorBrush x:Key="StewardHueAmberBrush" Color="#FFC83D" />
            <SolidColorBrush x:Key="StewardHueAmberSurfaceBrush" Color="#43351A" />
            <SolidColorBrush x:Key="StewardHuePurpleBrush" Color="#B9A6FF" />
            <SolidColorBrush x:Key="StewardHuePurpleSurfaceBrush" Color="#30284A" />
            <SolidColorBrush x:Key="StewardHuePinkBrush" Color="#FF9AA8" />
            <SolidColorBrush x:Key="StewardHuePinkSurfaceBrush" Color="#45252F" />
            <SolidColorBrush x:Key="StewardHueGreenBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StewardHueGreenSurfaceBrush" Color="#2A3A25" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StewardCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardCanvasAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardIconWellBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StewardBrandSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardBrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StewardFocusInnerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardChipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardDangerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardInfoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHueBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHueBlueSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHueTealBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHueTealSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHueAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHueAmberSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHuePurpleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHuePurpleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHuePinkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHuePinkSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StewardHueGreenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StewardHueGreenSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
