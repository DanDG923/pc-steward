<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI polish Phase 1 (ADR-030 concept A "Calm Native"; approved dark targets, 2026-11-11): Fluent theme brushes over Mica.
         The July 2026 custom navy palette (design/design-tokens.json) is retired. Pages keep using the semantic Steward* keys;
         in Light, Dark and Default each neutral key is an alias of a Windows App SDK theme brush, so cards, strokes, text and
         the accent follow the Windows theme and the user's accent colour:
         - canvas = SolidBackgroundFillColorBase (shown only where Mica and Desktop Acrylic are unavailable); surface = card
           layer (CardBackgroundFillColorDefault); subtle surfaces and the informational band = CardBackgroundFillColorSecondary;
           strokes = CardStrokeColorDefault and ControlStrongStrokeColorDefault; accent = AccentTextFillColorPrimary.
         - Caption and metadata text (StewardTertiaryTextBrush) deliberately uses TextFillColorSecondary, not
           TextFillColorTertiary, which is below 4.5:1 on light cards.
         Custom colours remain only for the status tones (success, warning, danger and information) and their tinted surfaces.
         They follow the Windows 11 system fill colours and are checked at 4.5:1 or better against their own surface and against
         the Windows 11 base and card colours in light and dark by UiAccessibilityContractTests (WCAG 1.4.3).
         The navigation pane and the content area are transparent over Mica, and NavigationView keeps its standard selection
         (subtle fill and accent pill); the earlier selected-item overrides are removed.
         High contrast stays mapped to SystemColor* resources. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="StewardCanvasBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
            <StaticResource x:Key="StewardCanvasAltBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="StewardSurfaceSubtleBrush" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardIconWellBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="StewardBorderStrongBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="StewardTextBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="StewardSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardTertiaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardBrandBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="StewardBrandSubtleBrush" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="StewardBrandTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="StewardFocusBrush" ResourceKey="FocusStrokeColorOuterBrush" />
            <StaticResource x:Key="StewardFocusInnerBrush" ResourceKey="FocusStrokeColorInnerBrush" />
            <SolidColorBrush x:Key="StewardChipBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="StewardSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StewardSuccessSurfaceBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="StewardWarningBrush" Color="#8A5300" />
            <SolidColorBrush x:Key="StewardWarningSurfaceBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="StewardDangerBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="StewardDangerSurfaceBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="StewardInfoBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="StewardInfoSurfaceBrush" Color="#E5F1FB" />
            <!-- Colour option 2 (owner choice 2026-11-11): Settings-style hues for decorative icon wells; each glyph is at least 4.5:1 on its surface. -->
            <SolidColorBrush x:Key="StewardHueBlueBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="StewardHueBlueSurfaceBrush" Color="#DCEBFA" />
            <SolidColorBrush x:Key="StewardHueTealBrush" Color="#00735C" />
            <SolidColorBrush x:Key="StewardHueTealSurfaceBrush" Color="#D5F2EA" />
            <SolidColorBrush x:Key="StewardHueAmberBrush" Color="#8A5300" />
            <SolidColorBrush x:Key="StewardHueAmberSurfaceBrush" Color="#FFF0CC" />
            <SolidColorBrush x:Key="StewardHuePurpleBrush" Color="#6B4FBB" />
            <SolidColorBrush x:Key="StewardHuePurpleSurfaceBrush" Color="#ECE6FB" />
            <SolidColorBrush x:Key="StewardHuePinkBrush" Color="#B4264A" />
            <SolidColorBrush x:Key="StewardHuePinkSurfaceBrush" Color="#FBE3E8" />
            <SolidColorBrush x:Key="StewardHueGreenBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StewardHueGreenSurfaceBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="StewardCanvasBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
            <StaticResource x:Key="StewardCanvasAltBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
