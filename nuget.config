<?xml version="1.0" encoding="utf-8"?>
<!-- Codex security scan finding 1: restore only from nuget.org into the one package folder the build names. Machine-wide
     configs (for example a Visual Studio install) can add other sources and fallback package folders; both are cleared so
     every package a build uses is downloaded into, and checked in, that folder. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
