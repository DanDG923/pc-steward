<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>0.1.19</VersionPrefix>
    <VersionSuffix>private-beta</VersionSuffix>
  </PropertyGroup>
  <!--
    Task 71 (ADR-029): the one-request AI test build, with the Task 69 candidate reviewed and paid requests in first-live-test
    mode. Only scripts/New-AdvisoryAiFirstLiveTestBuild.ps1 sets this property. It is never part of a release: the release
    candidate builder refuses any payload whose PCSteward.Domain.dll carries the test-build mark.
  -->
  <PropertyGroup Condition="'$(PCStewardAiFirstLiveTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PCSTEWARD_AI_FIRST_LIVE_TEST</DefineConstants>
  </PropertyGroup>
</Project>
